<?xml version='1.0' encoding='utf-8'?>
<interface version="1.4" author="PygubuDesigner 0.39.3">
  <project>
    <settings>
      <setting id="name">xTwitter Automated</setting>
      <setting id="description">an automateio program for managing xTwitter bots</setting>
      <setting id="module_name">xTwitterManager</setting>
      <setting id="template">application</setting>
      <setting id="main_widget">root</setting>
      <setting id="main_classname">TkGUI</setting>
      <setting id="main_menu" />
      <setting id="output_dir" />
      <setting id="output_dir2" />
      <setting id="import_tkvariables">False</setting>
      <setting id="use_ttk_styledefinition_file">False</setting>
      <setting id="use_i18n">False</setting>
      <setting id="all_ids_attributes">False</setting>
      <setting id="generate_code_onsave">False</setting>
      <setting id="use_window_centering_code">False</setting>
      <setting id="ttk_style_definition_file" />
    </settings>
    <customwidgets />
  </project>
  <object class="tk.Tk" id="root" named="True">
    <property name="background">#00002b</property>
    <property name="borderwidth">1</property>
    <property name="geometry">650x800</property>
    <property name="height">800</property>
    <property name="padx">5</property>
    <property name="pady">5</property>
    <property name="relief">flat</property>
    <property name="resizable">none</property>
    <property name="takefocus">true</property>
    <property name="title" translatable="yes">Twitter BOT Manager</property>
    <property name="width">650</property>
    <child>
      <object class="tk.Label" id="title" named="True">
        <property name="background">#00002b</property>
        <property name="compound">center</property>
        <property name="font">{DejaVu Sans} 16 {}</property>
        <property name="foreground">#f3ebf5</property>
        <property name="justify">center</property>
        <property name="padx">5</property>
        <property name="pady">5</property>
        <property name="relief">flat</property>
        <property name="text" translatable="yes">
 Reddit To Twitter Bot Manager</property>
        <property name="width">25</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relx">0.5</property>
          <property name="rely">0.025</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Frame" id="post_details" named="True">
        <property name="background">#00002b</property>
        <property name="borderwidth">1</property>
        <property name="container">true</property>
        <property name="height">200</property>
        <property name="padx">1</property>
        <property name="pady">1</property>
        <property name="relief">ridge</property>
        <property name="takefocus">false</property>
        <property name="width">200</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relheight">0.26</property>
          <property name="relwidth">0.64</property>
          <property name="relx">0.50</property>
          <property name="rely">0.23</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Text" id="search_bar" named="True">
        <property name="font">{DejaVu Math TeX Gyre} 10 {}</property>
        <property name="foreground">#000000</property>
        <property name="height">10</property>
        <property name="relief">flat</property>
        <property name="state">normal</property>
        <property name="takefocus">true</property>
        <property name="width">50</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relheight">0.03</property>
          <property name="relx">0.501</property>
          <property name="rely">0.39</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Button" id="post" named="True">
        <property name="compound">center</property>
        <property name="default">active</property>
        <property name="state">normal</property>
        <property name="takefocus">false</property>
        <property name="text" translatable="yes">Post</property>
        <bind sequence="&lt;ButtonPress&gt;" handler="make_post" add="" />
        <bind sequence="&lt;Enter&gt;" handler="make_post" add="" />
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relwidth">0.4</property>
          <property name="relx">0.62</property>
          <property name="rely">0.44</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Entry" id="username" named="True">
        <property name="exportselection">true</property>
        <property name="font">{DejaVu Serif} 12 {}</property>
        <property name="justify">left</property>
        <property name="state">normal</property>
        <property name="takefocus">true</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="height">27</property>
          <property name="relx">0.297</property>
          <property name="rely">0.438</property>
          <property name="width">145</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
  </object>
</interface>
